  <diagram name="02 Request and authentication flow" id="NRfxgxF7ZNM8fxq3MGnU">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#17324D;" value="Typical request and authentication flow" vertex="1">
          <mxGeometry height="40" width="700" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="f" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#3BA55C;fontSize=14;align=left;spacingLeft=12;" value="Any Next.js app&#xa;client / engineer / finance&#xa;&#xa;Axios client reads NEXT_PUBLIC_API_BASE_URL, stores access_token in localStorage, and attaches Authorization: Bearer …" vertex="1">
          <mxGeometry height="150" width="260" x="50" y="150" as="geometry" />
        </mxCell>
        <mxCell id="auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFF;strokeColor=#8E5CC7;fontSize=14;align=left;spacingLeft=12;" value="FastAPI /api/v1/auth&#xa;&#xa;POST /login&#xa;POST /login/verify (OTP)&#xa;POST /new-access-token&#xa;GET /profile&#xa;&#xa;JWT access token + refresh-token cookie" vertex="1">
          <mxGeometry height="190" width="280" x="440" y="130" as="geometry" />
        </mxCell>
        <mxCell id="security" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D99A00;fontSize=14;align=left;spacingLeft=12;" value="Security dependencies&#xa;&#xa;access_bearer validates token&#xa;role / identity guards enforce access&#xa;Redis holds blocklist and OAuth state&#xa;UserService handles login, OTP and refresh" vertex="1">
          <mxGeometry height="190" width="290" x="850" y="130" as="geometry" />
        </mxCell>
        <mxCell id="domain" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFF;strokeColor=#8E5CC7;fontSize=14;align=left;spacingLeft=12;" value="Role-specific API routers&#xa;&#xa;Engineer: monitoring, clients/sites, PV, panels, degradation, MPPT, battery SOC, string wiring&#xa;&#xa;Finance/Admin: clients, sites, contracts, settings, invoices, jobs, Xero&#xa;&#xa;Client: client-facing profile/site data" vertex="1">
          <mxGeometry height="205" width="430" x="440" y="450" as="geometry" />
        </mxCell>
        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFF;strokeColor=#8E5CC7;fontSize=14;align=left;spacingLeft=12;" value="Service + repository layer&#xa;&#xa;Request models validate input&#xa;Services apply business rules&#xa;Repositories use SQLModel / SQLAlchemy&#xa;Responses are wrapped in ServerRespModel" vertex="1">
          <mxGeometry height="165" width="290" x="960" y="470" as="geometry" />
        </mxCell>
        <mxCell id="result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#4A90E2;fontSize=14;align=left;spacingLeft=12;" value="Response to dashboard&#xa;JSON data, PDF redirect, or SSE stream&#xa;&#xa;Finance job status is polled / streamed from /jobrun; site stats can stream from Redis-backed SSE" vertex="1">
          <mxGeometry height="155" width="260" x="50" y="490" as="geometry" />
        </mxCell>
        <mxCell id="retry" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D6B656;fontSize=13;align=left;spacingLeft=12;" value="401 path in engineer/finance apps&#xa;&#xa;1. mark original request for retry&#xa;2. call /auth/new-access-token with credentials&#xa;3. save new access token&#xa;4. replay queued requests&#xa;5. redirect to /auth/login if refresh fails" vertex="1">
          <mxGeometry height="135" width="400" x="850" y="710" as="geometry" />
        </mxCell>
        <mxCell id="a1" edge="1" parent="1" source="f" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#3BA55C;" target="auth" value="login / API call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" parent="1" source="auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#8E5CC7;" target="f" value="token + cookie">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" edge="1" parent="1" source="auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#D99A00;" target="security" value="validate / authorize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" source="security" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#8E5CC7;" target="domain" value="authorized request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" source="domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#8E5CC7;" target="svc" value="service call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" edge="1" parent="1" source="svc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#4A90E2;" target="result" value="JSON / SSE / redirect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" edge="1" parent="1" source="security" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#D35B5B;" target="retry" value="401 / refresh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
