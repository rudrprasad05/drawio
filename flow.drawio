        </mxCell>
        <mxCell id="dynamo" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF7E6;strokeColor=#D99A00;fontSize=14;fontStyle=1;" value="AWS DynamoDB&#xa;AWS_TIME_SERIES_TABLE&#xa;Raw / high-frequency time-series readings" vertex="1">
