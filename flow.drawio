        <mxCell id="redis" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFEAEA;strokeColor=#D35B5B;fontSize=14;fontStyle=1;" value="Redis&#xa;Celery broker + result backend&#xa;RedBeat schedule store&#xa;Site stats / energy portfolio cache&#xa;SSE source and OAuth state" vertex="1">
