        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;" value="Switch Fiji — current system architecture" vertex="1">
          <mxGeometry height="40" width="700" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#52606D;align=left;" value="Observed from switch-fiji-client and switch-fiji-server source trees" vertex="1">
          <mxGeometry height="25" width="700" x="42" y="65" as="geometry" />
        </mxCell>
        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#4A90E2;fontSize=15;fontStyle=1;" value="Users / external systems&#xa;Client users • Engineers • Finance/Admin staff&#xa;Field devices / telemetry producers" vertex="1">
          <mxGeometry height="115" width="250" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="frontends" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#3BA55C;fontSize=14;align=left;spacingLeft=14;" value="switch-fiji-client&#xa;&#xa;Next.js apps&#xa;• client — client-facing app&#xa;• engineer — engineering dashboard&#xa;• finance — billing/admin dashboard&#xa;&#xa;Shared packages: api, auth, ui, types" vertex="1">
          <mxGeometry height="170" width="330" x="380" y="125" as="geometry" />
        </mxCell>
        <mxCell id="http" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D99A00;fontSize=13;" value="HTTPS / JSON&#xa;Bearer access token&#xa;Refresh cookie when 401&#xa;SSE streams for live stats / jobs" vertex="1">
