        </mxCell>
        <mxCell id="beat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECF5;strokeColor=#C04B86;fontSize=14;align=left;spacingLeft=12;" value="Celery Beat / RedBeat&#xa;&#xa;Periodic schedules trigger stats, flow graph, invoices, snapshots, MPPT/BA3 SOC, energy usage and Xero maintenance/retries." vertex="1">
