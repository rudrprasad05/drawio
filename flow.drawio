          <mxGeometry height="155" width="330" x="405" y="430" as="geometry" />
        </mxCell>
        <mxCell id="worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECF5;strokeColor=#C04B86;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" value="Celery worker tasks&#xa;&#xa;Read telemetry + operational data&#xa;Compute site stats, energy usage, degradation, flow graph and invoice periods&#xa;Persist job runs, snapshots, cached results and exports" vertex="1">
